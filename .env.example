ROUTER9_API_KEY=API_KEY_CUA_BAN

ENABLE_CHATGPT=true
ENABLE_GROQ=false
ENABLE_OPENROUTER=false

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cách 1 — ưu tiên để test nếu bạn có Access Token hợp lệ
CHATGPT_ACCESS_TOKEN=
CHATGPT_ACCESS_TOKEN_EXPIRES_IN=0

# Cách 2 — Refresh Token
CHATGPT_REFRESH_TOKEN=

# OAuth client configuration
CHATGPT_CLIENT_ID=
CHATGPT_REDIRECT_URI=com.openai.chat://auth0.openai.com/ios/com.openai.chat/callback
CHATGPT_AUTH_URL=https://auth0.openai.com/oauth/token

CHATGPT_TOKEN_STATE_FILE=/var/data/apirouter-chatgpt-token.json
CHATGPT_KEEPALIVE_HOURS=6

REQUEST_TIMEOUT=45
PROVIDER_TIMEOUT=30
MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=8

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30

OPENROUTER_REFERER=https://github.com/9router/9router
OPENROUTER_TITLE=9Router v3

ALIAS_GPT_4O=chatgpt:gpt-4o,groq:openai/gpt-oss-120b,openrouter:openai/gpt-4o
ALIAS_GPT_4O_MINI=chatgpt:gpt-4o-mini,groq:llama-3.1-8b-instant,openrouter:google/gemini-2.5-flash-lite
ALIAS_GPT_4_TURBO=chatgpt:gpt-4-turbo,groq:openai/gpt-oss-120b,openrouter:openai/gpt-4o
ALIAS_GPT_3_5_TURBO=chatgpt:gpt-3.5-turbo,groq:llama-3.1-8b-instant,openrouter:google/gemini-2.5-flash-lite

CHATGPT_WEB_SEARCH_MODE=auto
