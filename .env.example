ROUTER9_API_KEY=change-me

# Providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Primary provider: ChatGPT Web OAuth refresh-token flow.
CHATGPT_REFRESH_TOKEN=
CHATGPT_TOKEN_STATE_FILE=/var/data/apirouter-chatgpt-token.json
CHATGPT_KEEPALIVE_HOURS=6
ENABLE_CHATGPT=true
ENABLE_GROQ=true
ENABLE_OPENROUTER=true

# Limits
REQUEST_TIMEOUT=45
PROVIDER_TIMEOUT=30
MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=8

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30

# OpenRouter attribution
OPENROUTER_REFERER=https://github.com/apirouter/apirouter
OPENROUTER_TITLE=ApiRouter v3

# Routing aliases: highest priority first.
ALIAS_GPT_4O=chatgpt:gpt-4o,groq:openai/gpt-oss-120b,openrouter:openai/gpt-4o
ALIAS_GPT_4O_MINI=chatgpt:gpt-4o-mini,groq:llama-3.1-8b-instant,openrouter:google/gemini-2.5-flash-lite
ALIAS_GPT_4_TURBO=chatgpt:gpt-4-turbo,groq:openai/gpt-oss-120b,openrouter:openai/gpt-4o
ALIAS_GPT_3_5_TURBO=chatgpt:gpt-3.5-turbo,groq:llama-3.1-8b-instant,openrouter:google/gemini-2.5-flash-lite

# Native ChatGPT Web search only; no external search API.
# auto = hint on realtime-looking prompts; always = hint every prompt; off = disabled.
CHATGPT_WEB_SEARCH_MODE=auto
