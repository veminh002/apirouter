ROUTER9_API_KEY=API_KEY_CUA_BAN

ENABLE_CHATGPT=true
ENABLE_GROQ=false
ENABLE_OPENROUTER=false

GROQ_API_KEY=
OPENROUTER_API_KEY=

CHATGPT_ACCESS_TOKEN=
CHATGPT_ACCESS_TOKEN_EXPIRES_IN=0

CHATGPT_REFRESH_TOKEN=
CHATGPT_CLIENT_ID=
CHATGPT_REDIRECT_URI=http://localhost:1455/auth/callback
CHATGPT_AUTH_URL=https://auth.openai.com/oauth/token

CHATGPT_ACCOUNT_ID=

CHATGPT_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses

CHATGPT_ORIGINATOR=codex_cli_rs
CHATGPT_VERSION=0.142.3

CHATGPT_MODEL_GPT_4O=gpt-5.4
CHATGPT_MODEL_GPT_4O_MINI=gpt-5.4-mini
CHATGPT_MODEL_GPT_4_TURBO=gpt-5.4
CHATGPT_MODEL_GPT_3_5_TURBO=gpt-5.4-mini

CHATGPT_TOKEN_STATE_FILE=/var/data/apirouter-chatgpt-token.json
CHATGPT_KEEPALIVE_HOURS=6

CHATGPT_WEB_SEARCH_MODE=auto

REQUEST_TIMEOUT=45
PROVIDER_TIMEOUT=30
MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=8

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30

OPENROUTER_REFERER=https://github.com/9router/9router
OPENROUTER_TITLE=9Router v3
